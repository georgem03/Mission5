@{
    ViewData["Title"] = "Soccer Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to My Soccer World ⚽</h1>
</div>

<div class="container mt-4">

    <img src="https://images.unsplash.com/photo-1518091043644-c1d4457512c6"
         class="img-fluid mb-3" alt="Soccer field" />

    <p>
        Soccer has been my favorite hobby since I was young. I love the strategy,
        teamwork, and technical skill required to play at a high level.
    </p>

    <p>
        Whether it's playing competitively, practicing drills, or studying game
        tactics, soccer teaches discipline, leadership, and perseverance.
    </p>

    <p>
        I enjoy helping others improve their skills, understand positioning,
        and develop confidence on the field.
    </p>

    <div class="mt-4">
        <a class="btn btn-success" asp-controller="Home" asp-action="Calculator">
            Calculate Tutoring Cost
        </a>
    </div>

</div>